---
import Base from "../../layouts/Base.astro";
import { posts } from "../../content/posts";

export function getStaticPaths() {
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
---
<Base title={post.title}>
  <article class="article">
    <a href="/" class="back">← &nbsp;All stories</a>
    <div class="art"><div class="ring"></div></div>
    <div class="meta"><span>{post.category}</span><span>{post.date} · 5 MIN READ</span></div>
    <h1>{post.title}</h1>
    <p class="intro">{post.intro}</p>
    <div class="body">
      {post.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
      <a class="cta" href="http://localhost:4322">Explore the API documentation ↗</a>
    </div>
  </article>
</Base>
<style>
.article{max-width:700px;margin:42px auto 90px;padding:0 24px}.back{font-size:11px;text-decoration:none;color:#7668d6}.art{height:260px;background:#f0efff;border-radius:11px;margin:24px 0;display:grid;place-items:center;overflow:hidden}.ring{width:120px;height:120px;border:1px solid #7567e0;border-radius:50%;position:relative}.ring:before,.ring:after{content:"";position:absolute;inset:-30px 15px;border:1px solid #b3acf3;border-radius:50%;transform:rotate(55deg)}.ring:after{transform:rotate(-55deg);inset:15px -30px}.meta{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.9px;color:#999faf}.meta span:first-child{color:#5e4bd6;font-weight:700}h1{font:800 37px/1.15 Manrope;letter-spacing:-1.2px;margin:18px 0}.intro{font:500 16px/1.7 Manrope;color:#727d8e;border-left:2px solid #7564e4;padding-left:17px}.body{color:#586477;font-size:13px;line-height:1.9;margin-top:30px}.body h2{font:700 20px Manrope;color:#1d2737;margin-top:30px}.cta{display:inline-block;background:#5b49db;color:white;border-radius:7px;padding:12px 16px;text-decoration:none;font-size:11px;font-weight:700;margin-top:10px}@media(max-width:600px){.article{margin-top:25px}.art{height:200px}h1{font-size:30px}}
</style>
