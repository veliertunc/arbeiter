---
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { posts } from "../content/posts";
---
<Base title="Arbeiter Journal — Ideas on identity"><section class="hero"><div class="kicker"><span></span> THE ARBEITER JOURNAL</div><h1>Ideas for a more<br/><em>secure internet.</em></h1><p>Engineering notes, product thinking, and practical guides to building identity into your product.</p><div class="hero-orbit"></div><div class="hero-shape">a</div></section><section class="posts"><div class="section-head"><div><span class="eyebrow">LATEST STORIES</span><h2>From the journal</h2></div><span class="count">{String(posts.length).padStart(2, "0")} ARTICLES</span></div><div class="grid">{posts.map((post, i) => <ArticleCard post={post} index={i} />)}</div><div class="subscribe"><div><span class="eyebrow">THE OCCASIONAL NOTE</span><h2>Thoughtful reads.<br/>Straight to your inbox.</h2></div><form><input type="email" aria-label="Email address" placeholder="Your email address"/><button type="button">Coming soon →</button></form></div></section></Base>
<style>
.hero{height:390px;background:#f0efff;position:relative;overflow:hidden;padding:80px max(calc((100% - 1064px)/2),7%)}.kicker,.eyebrow{font-size:9px;letter-spacing:1.3px;font-weight:700;color:#6554db}.kicker span{display:inline-block;width:6px;height:6px;background:#6b59e1;border-radius:50%;margin-right:8px}h1{font:800 54px/1.06 Manrope,sans-serif;letter-spacing:-2.9px;margin:22px 0 14px;position:relative;z-index:2}h1 em{font-style:normal;color:#6250dc}.hero>p{color:#788395;font-size:13px;line-height:1.7;max-width:400px;position:relative;z-index:2}.hero-shape{position:absolute;right:15%;top:75px;width:255px;height:255px;border-radius:70px;transform:rotate(15deg);display:grid;place-items:center;background:linear-gradient(135deg,#7164e7,#503fd0);color:#fff;font:800 140px Manrope;box-shadow:20px 28px 55px #4835b333}.hero-orbit{position:absolute;border:1px solid #d7d3fc;border-radius:50%;right:7%;top:7%;width:400px;height:400px}.posts{max-width:1064px;margin:0 auto;padding:56px 28px 72px}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px}.section-head h2,.subscribe h2{font:700 23px Manrope;letter-spacing:-.6px;margin:8px 0 0}.count{font-size:9px;color:#9ea6b3;letter-spacing:1px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.post{text-decoration:none;color:inherit}.art{height:170px;border-radius:9px;position:relative;overflow:hidden;background:#f1f0ff;display:grid;place-items:center}.art>span{position:absolute;top:12px;left:14px;font-size:9px;color:#8175e4;letter-spacing:1px}.art-circle{width:90px;height:90px;border:1px solid #8578e8;border-radius:50%;position:relative}.art-circle:before,.art-circle:after{content:"";position:absolute;border:1px solid #aaa1f1;border-radius:50%;inset:14px -22px}.art-circle:after{inset:-20px 15px}.art-1{background:#edf5ff}.art-1 .art-circle{border-color:#4b96d9;transform:rotate(45deg)}.art-1 .art-circle:before,.art-1 .art-circle:after{border-color:#a2cbee}.art-2{background:#f5f1eb}.art-2 .art-circle{background:#edddca;border:0;border-radius:32% 68% 61% 39%;transform:rotate(-25deg)}.meta{display:flex;justify-content:space-between;margin-top:15px;font-size:8px;letter-spacing:.8px;color:#8b95a4}.meta span:first-child{color:#5f50cc;font-weight:700}.post h3{font:700 15px/1.4 Manrope;margin:10px 0 7px;letter-spacing:-.25px}.post p{font-size:10px;line-height:1.7;color:#7c8797;margin:0}.read{display:inline-block;color:#5a48d7;font-size:10px;font-weight:700;margin-top:13px}.read b{margin-left:4px}.subscribe{margin-top:55px;background:#f4f3ff;border-radius:10px;padding:28px 32px;display:flex;align-items:center;justify-content:space-between}.subscribe h2{font-size:19px;line-height:1.4}.subscribe form{display:flex;gap:8px}.subscribe input{height:38px;width:220px;border:1px solid #e5e3f7;border-radius:6px;padding:0 11px;font:10px 'DM Sans'}.subscribe button{border:0;border-radius:6px;background:#d8d4f9;color:#6155b9;padding:0 14px;font:700 10px 'DM Sans'}@media(max-width:720px){.hero{height:360px;padding:65px 7%}.hero-shape{width:120px;height:120px;right:8%;top:200px;border-radius:36px;font-size:72px;opacity:.8}.hero-orbit{display:none}h1{font-size:43px}.grid{grid-template-columns:1fr}.art{height:200px}.subscribe{align-items:flex-start;gap:18px;flex-direction:column}.subscribe form{width:100%}.subscribe input{flex:1;min-width:0}}
</style>
