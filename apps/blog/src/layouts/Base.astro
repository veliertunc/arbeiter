---
const { title = "Arbeiter Journal", description = "Notes on authentication and building secure products." } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet"/></head><body><header><a class="brand" href="/"><span>a</span> arbeiter</a><nav><a href="/">Journal</a><a href="http://localhost:4322">Docs ↗</a><a class="nav-cta" href="http://localhost:3000">Get started</a></nav></header><main><slot/></main><footer><a class="brand" href="/"><span>a</span> arbeiter</a><small>Identity infrastructure for the next generation of products.</small><small>© 2026 Arbeiter</small></footer></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#1a2332;background:#fafbfe;font-synthesis:none}*{box-sizing:border-box}body{margin:0}header,footer{max-width:1120px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:23px 28px}.brand{display:flex;align-items:center;gap:9px;color:#172133;text-decoration:none;font:800 18px Manrope,sans-serif}.brand span{display:grid;place-items:center;width:28px;height:28px;color:white;background:#5844dc;border-radius:9px}nav{display:flex;align-items:center;gap:30px}nav a{font-size:12px;text-decoration:none;color:#687486}.nav-cta{background:#5946db;border-radius:7px;color:white;padding:10px 14px;font-weight:700}main{min-height:75vh}footer{border-top:1px solid #eceef3;color:#98a1af;font-size:10px}footer .brand{font-size:14px}footer .brand span{width:22px;height:22px;border-radius:7px;font-size:14px}footer small{font-size:10px}@media(max-width:600px){header,footer{padding:18px}nav{gap:12px}nav a{font-size:10px}footer{align-items:flex-start;gap:10px;flex-direction:column}}
</style>
